---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";

// Helper to handle base path
const base = import.meta.env.BASE_URL || '/';
const withBase = (path: string) => base === '/' ? path : base.replace(/\/$/, '') + path;
const companyLogos = [
  { src: withBase('/logos/aws.svg'), alt: 'Amazon Web Services logo' },
  { src: withBase('/logos/samsung-sds.png'), alt: 'Samsung SDS logo' },
  { src: withBase('/logos/american-express.png'), alt: 'American Express logo' },
];
---

<BaseLayout sideBarActiveItemID="home">
  <div class="py-8 sm:py-12 text-center">
    <h1 class="text-5xl md:text-6xl font-bold">Ena Kovac</h1>
    <div
      id="helloType"
      class="mt-3 text-xl md:text-2xl font-mono text-base-content/70 inline-block"
      style="min-height: 1.6em; min-width: 12ch; height: 1.6em; line-height: 1.6; white-space: pre;"
    >
      Hello World!
    </div>
    <p class="mt-8 mx-auto max-w-2xl text-lg leading-relaxed">
      I’m a Computer Science student at Cornell Engineering with a minor in Artificial Intelligence.
      I’m an incoming Software Development Engineer at Amazon Web Services, and previously worked at Samsung SDS and American Express.
      I enjoy machine learning, automation, and building software that solves real problems simply and reliably.
    </p>
  </div>
  <div class="mt-6 py-4">
    <div class="max-w-4xl mx-auto flex flex-col items-center">
      <div class="w-full flex justify-center">
        <img
          id="companyLogo"
          src={companyLogos[0].src}
          alt={companyLogos[0].alt}
          data-logos={JSON.stringify(companyLogos)}
          class="max-h-14 sm:max-h-16 w-auto object-contain transition-opacity duration-500"
          loading="lazy"
        />
      </div>
    </div>
  </div>

  <!-- Projects removed from home page per user request -->

  <section id="highlights" class="mt-10 max-w-5xl mx-auto px-4">
    <div class="text-left">
      <h2 class="text-2xl font-semibold mb-4">Highlights</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <a href={withBase('/projects/websocket-management#architecture')} class="card bg-base-200 shadow hover:shadow-lg transition">
          <div class="card-body">
            <h3 class="card-title text-lg">WebSocket Architecture Diagram</h3>
            <p class="text-sm text-base-content/80">View the API Gateway + Lambda + DynamoDB flow from the AWS project.</p>
            <span class="link link-hover text-sm mt-1">Jump to diagram</span>
          </div>
        </a>
        <a href={withBase('/projects/benchmark-lineage#slides')} class="card bg-base-200 shadow hover:shadow-lg transition">
          <div class="card-body">
            <h3 class="card-title text-lg">Benchmark Lineage Slides (CS4775)</h3>
            <p class="text-sm text-base-content/80">Open the embedded PDF walkthrough of the lineage experiments.</p>
            <span class="link link-hover text-sm mt-1">Open slides</span>
          </div>
        </a>
        <a href={withBase('/cv')} class="card bg-base-200 shadow hover:shadow-lg transition">
          <div class="card-body">
            <h3 class="card-title text-lg">Resume (PDF)</h3>
            <p class="text-sm text-base-content/80">Preview and download the latest resume directly.</p>
            <span class="link link-hover text-sm mt-1">View resume</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    const typeHello = () => {
      const target = document.getElementById('helloType');
      if (!target) return;
      const text = 'Hello World!';
      if (window.__helloTypeTimer) {
        window.clearTimeout(window.__helloTypeTimer);
      }
      target.textContent = '\u00a0';
      let i = 0;
      let deleting = false;

      const step = () => {
        if (!deleting) {
          target.textContent = text.slice(0, i + 1);
          i += 1;
          if (i === text.length) {
            deleting = true;
            window.__helloTypeTimer = window.setTimeout(step, 800);
            return;
          }
        } else {
          target.textContent = text.slice(0, i - 1) || '\u00a0';
          i -= 1;
          if (i === 0) {
            deleting = false;
            window.__helloTypeTimer = window.setTimeout(step, 600);
            return;
          }
        }
        window.__helloTypeTimer = window.setTimeout(step, 90);
      };
      step();
    };

    const startLogoRotation = () => {
      const logoEl = document.getElementById('companyLogo');
      if (!logoEl) return;
      const logos = JSON.parse(logoEl.dataset.logos || '[]');
      if (logos.length === 0) return;
      if (window.__logoRotationInterval) {
        clearInterval(window.__logoRotationInterval);
      }
      let index = 0;
      window.__logoRotationInterval = window.setInterval(() => {
        index = (index + 1) % logos.length;
        logoEl.classList.add('opacity-0');
        window.setTimeout(() => {
          logoEl.src = logos[index].src;
          logoEl.alt = logos[index].alt;
          logoEl.classList.remove('opacity-0');
        }, 250);
      }, 2000);
    };

    const onLoad = () => {
      typeHello();
      startLogoRotation();
    };

    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', onLoad, { once: true });
    } else {
      onLoad();
    }
    document.addEventListener('astro:page-load', onLoad);
  </script>
</BaseLayout>
