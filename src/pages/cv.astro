---
import BaseLayout from "../layouts/BaseLayout.astro";

const resumeHref = import.meta.env.DEV
  ? "/resume.pdf"
  : new URL("resume.pdf", Astro.site).pathname;
---

<BaseLayout title="Resume" sideBarActiveItemID="Resume">
  <div class="min-h-screen flex flex-col gap-4 items-center justify-start p-4 sm:p-8">
    <div class="text-center max-w-2xl">
      <p class="mb-3 text-xl font-medium">Download or preview my resume below.</p>
      <a href={resumeHref} class="btn btn-outline btn-primary" target="_blank" rel="noopener noreferrer">Open PDF in new tab</a>
    </div>

    <div class="w-full max-w-screen-2xl h-[92vh] border rounded-lg shadow-xl bg-base-200/70 overflow-hidden">
      <object data={resumeHref} type="application/pdf" class="w-full h-full">
        <div class="p-4 text-center text-sm">
          <p class="mb-2">If the embedded preview doesn’t load, use the link above to open the PDF directly.</p>
          <a href={resumeHref} class="link">Download resume PDF</a>
        </div>
      </object>
    </div>
  </div>
</BaseLayout>
