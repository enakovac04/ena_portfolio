---
import BaseLayout from "../layouts/BaseLayout.astro";

const resumeHref = import.meta.env.DEV
  ? "/resume.pdf"
  : new URL("resume.pdf", Astro.site).pathname;
---

<BaseLayout title="Resume" sideBarActiveItemID="Resume">
  <div class="min-h-[60vh] flex flex-col gap-6 items-center justify-center p-8">
    <div class="text-center max-w-2xl">
      <h2 class="text-3xl font-bold mb-3">Resume</h2>
      <p class="mb-4 text-lg">Download or preview my current resume below.</p>
      <a href={resumeHref} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Open PDF in new tab</a>
    </div>

    <div class="w-full max-w-3xl h-[70vh] border rounded-lg shadow-lg bg-base-200/60 overflow-hidden">
      <object data={resumeHref} type="application/pdf" class="w-full h-full">
        <div class="p-4 text-center text-sm">
          <p class="mb-2">If the embedded preview doesn’t load, use the link above to open the PDF directly.</p>
          <a href={resumeHref} class="link">Download resume PDF</a>
        </div>
      </object>
    </div>
  </div>
</BaseLayout>
